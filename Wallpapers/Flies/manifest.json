{
  "id": "builtin-flies",
  "title": "桌面苍蝇",
  "author": "DeskCanvas",
  "description": "图标附近的苍蝇生态。按住 Alt 拍打，按住 Ctrl 清扫；均需命中两次。",
  "version": "1.0.0",
  "type": "web",
  "category": "特效壁纸",
  "tags": ["互动", "生态", "苍蝇"],
  "entry": "index.html",
  "preview": "preview.png",
  "interactive": true,
  "desktopEnvironment": true,
  "transparent": true,
  "recommendedFps": 30,
  "properties": {
    "maxFlies": {
      "type": "number",
      "default": 30,
      "min": 1,
      "max": 60,
      "step": 1
    },
    "spawnMinutes": {
      "type": "number",
      "default": 5,
      "min": 1,
      "max": 30,
      "step": 1
    },
    "flySize": {
      "type": "number",
      "default": 1,
      "min": 0.7,
      "max": 2,
      "step": 0.1
    }
  }
